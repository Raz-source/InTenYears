<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InTenYears.InTenYears1"
             Title="InTenYears1"
             BackgroundColor="LightYellow"
             >

    <Grid RowDefinitions="*,*" Margin="10">
        <Label TextColor="Tomato" Text="In ten years you will be" FontSize="50" Grid.Row="0" x:Name="Result"/>
        
        <VerticalStackLayout Grid.Row="1" Spacing="10" VerticalOptions="End">
            <Label Text="Your Name:" />
            <Entry />
            <Label Text="Your Age:" />
            <Entry Keyboard="Numeric"/>
            <Button Clicked="Button_ClickedCalculate"  Text="Calculate"></Button>
        </VerticalStackLayout>
            





    </Grid>
</ContentPage>