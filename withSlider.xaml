<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InTenYears.withSlider"
             Title="withSlider"
             BackgroundColor="LightYellow">


    <Grid RowDefinitions="*,*" Margin="10">
        <Label TextColor="Tomato" Text="In ten years you will be" FontSize="50" Grid.Row="0" x:Name="Result"/>

        <VerticalStackLayout Grid.Row="1" Spacing="10" VerticalOptions="End">
            <Label Text="Your Name:" />
            <Entry x:Name="EntName"/>
            <Label Text="Your Age:" />
            <Grid ColumnDefinitions="*,50">
            <Label  x:Name="EntAge" Grid.Column="1" />
            <Slider DragCompleted="Drag_Completed" Minimum="0" Maximum="100" x:Name="Slider" Grid.Column="0" ValueChanged="Slider_ValueChanged"></Slider>
                
                
            </Grid>
        </VerticalStackLayout>




    </Grid>
</ContentPage>